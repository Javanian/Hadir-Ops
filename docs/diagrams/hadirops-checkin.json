  "cards": [
    {
      "dot": "rose",
      "title": "Face first",
      "items": [
        "The app calls check-in only after the face matches the stored embedding; a mismatch asks for a new photo",
        "Embeddings live in PostgreSQL as pgvector columns"
      ]
    },
    {
      "dot": "cyan",
      "title": "Location",
      "items": [
        "Distance to the site is a Haversine check against the site radius",
        "Out-of-radius check-ins are recorded and flagged, not blocked"
      ]
    },
    {
      "dot": "amber",
      "title": "Shifts",
      "items": [
        "Temporary assignments override the home site and shift",
