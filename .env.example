# Copy to .env for local Docker Compose overrides.
COMPOSE_PROJECT_NAME=rollproof

# Production (docker-compose.prod.yml): the public host name. Point its DNS A/AAAA
# record at the server and open ports 80 and 443; Caddy obtains the certificate.
DOMAIN=rollproof.example.com

# MongoDB (docker-compose.yml runs a single-node replica set, no auth;
# docker-compose.prod.yml enables auth with DB_USER / DB_PASSWORD)
DB_NAME=rollproof
DB_USER=rollproof
# Production: a long random value, URL-safe because it goes into the connection
# string, for example: openssl rand -hex 24
DB_PASSWORD=change-me
DB_HOST_PORT=27018

BACKEND_PORT=8000
WEB_PORT=5173

WEB_API_BASE_URL=/api
WEB_API_PROXY_TARGET=http://backend:8000

EXPO_PUBLIC_API_BASE_URL=auto
EXPO_PUBLIC_API_PORT=8000
EXPO_PUBLIC_API_TIMEOUT=10000
