# Rollproof edge: HTTPS (certificates obtained and renewed automatically for
# DOMAIN), the web dashboard, and the API under /api for the dashboard and the
# mobile app. Caddy sets X-Forwarded-For, which the backend trusts so that
# login rate limits apply per employee rather than to the proxy.

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		Content-Security-Policy "default-src 'self'; connect-src 'self' https://nominatim.openstreetmap.org; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://unpkg.com; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle_path /api/* {
		# Face photos are capped at 5 MB by the API; refuse anything far larger here.
		request_body {
			max_size 8MB
		}
		reverse_proxy backend:8000 {
			health_uri /health/live
		}
	}

	handle {
		root * /srv
		# Hashed build assets never change; the HTML that names them must not be cached.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
