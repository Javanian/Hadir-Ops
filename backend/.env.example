# Backend runtime defaults. Docker Compose sets MONGODB_URL / MONGODB_DB itself.
# Transactions need a replica set (a single-node one is fine).

MONGODB_URL=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=hadirops

SECRET_KEY=change-this-secret-key-in-production-use-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","http://localhost:8081"]
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[0-1])\.\d+\.\d+|100\.(6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.\d+\.\d+)(:\d+)?$

MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30
RATE_LIMIT_LOGIN=10/minute
TIMEZONE=Asia/Jakarta

FACE_ENABLED=true
FACE_MODEL_NAME=buffalo_s
FACE_SIMILARITY_THRESHOLD=0.3
FACE_MAX_WIDTH=640
FACE_TOKEN_WINDOW_MINUTES=10

# Offline check-ins and device time
OFFLINE_MAX_AGE_HOURS=72
OFFLINE_THRESHOLD_SECONDS=120
CLOCK_SKEW_TOLERANCE_SECONDS=300
# Accuracy above this many metres is not trusted when checking the site radius
GPS_ACCURACY_CAP_M=150

# production refuses to start with the development SECRET_KEY
ENVIRONMENT=development
AUTO_CHECKOUT_ENABLED=true
AUTO_CHECKOUT_INTERVAL_SECONDS=60
